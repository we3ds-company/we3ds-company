# WE3DS — Default .gitignore

# ─── Operating Systems ───────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Editors & IDEs ──────────────────────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (PHPStorm, Rider, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Vim / Neovim
*.swp
*.swo
*.un~
Session.vim
.netrwhist

# Sublime Text
*.sublime-project
*.sublime-workspace

# ─── Environment & Secrets ───────────────────────────────────────────────────

.env
.env.local
.env.production
.env.staging
.env.*.local

# ─── PHP / Laravel ───────────────────────────────────────────────────────────

/vendor/
composer.lock
/storage/*.key
/public/hot
/public/storage
bootstrap/cache/*.php

# ─── Node.js / Frontend ──────────────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
.nuxt/
dist/
build/
out/
.cache/
.parcel-cache/

# ─── .NET / C# ───────────────────────────────────────────────────────────────

bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
[Tt]emp/
[Ll]ogs/
[Rr]elease/
[Dd]ebug/

# ─── Testing ─────────────────────────────────────────────────────────────────

coverage/
.coverage
*.lcov
test-results/
TestResults/

# ─── Logs ────────────────────────────────────────────────────────────────────

*.log
logs/
*.log.*

# ─── Docker ──────────────────────────────────────────────────────────────────

.docker/

# ─── Compiled & Generated ────────────────────────────────────────────────────

*.class
*.pyc
*.pyo
__pycache__/

# ─── Archives ────────────────────────────────────────────────────────────────

*.zip
*.tar.gz
*.rar
*.7z
